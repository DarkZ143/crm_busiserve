rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The application accesses Firestore through authenticated server routes using
    // the Firebase Admin SDK. Admin SDK requests bypass these client security rules.
    // Deny browser and mobile SDK access to every document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
